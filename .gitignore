# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example
.envrypt

# User config (contains RPC URL, wallet key, API keys)
user-config.json

# Local user-config copies and dated exports; keep the safe template trackable.
user-config*.json
user-config*.md
user-config*.txt
!user-config.example.json

# GMGN fee-source config (contains API key)
gmgn-config.json

# Stray Claude Code worktrees
.claude/worktrees/

# Runtime state (position tracking, lessons — user-specific)
state.json
lessons.json
smart-wallets.json
pool-memory.json
token-blacklist.json
strategy-library.json
decision-log.json
hivemind-cache.json
signal-weights.json
candidate-observations.json
circuit-breaker.json

# Durable trading/runtime evidence (retain locally; never publish)
/.meridian-lifecycle-operations/
/shadow-rollout-evidence.jsonl
/trade-ledger.jsonl

# Local operator notes and generated learning-pass scratch files
/.tmp_meridian_*.md
/_learning_pass_*.md

