{
  "name": "dlmm-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous DLMM LP agent for Meteora on Solana",
  "main": "index.js",
  "bin": {
    "meridian": "cli.js"
  },
  "scripts": {
    "setup": "node setup.js",
    "env:encrypt": "node scripts/envrypt.js encrypt",
    "start": "/usr/bin/flock --exclusive --nonblock --conflict-exit-code 75 /home/wiee/meridian/.meridian-live.lock /usr/bin/node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart meridian --update-env",
    "pm2:logs": "pm2 logs meridian --lines 100",
    "dev": "DRY_RUN=true node index.js",
    "test": "npm run test:syntax",
    "test:syntax": "find . -path ./node_modules -prune -o -name '*.js' -exec node --check {} \\;",
    "test:screen": "node test/test-screening.js",
    "test:agent": "DRY_RUN=true node test/test-agent.js",
    "test:settlement-report": "node test/test-settlement-report.js",
    "rollout:replay": "node scripts/rollout-replay.js",
    "rejected:replay": "node scripts/rejected-candidate-replay.js",
    "rollout:acceptance": "node scripts/rollout-acceptance.js",
    "test:rollout": "node test/test-rollout-safety.js && node test/test-wallet-balance-integrity.js && node test/test-rollout-replay.js && node test/test-shadow-lifecycle.js && node test/test-rejected-candidate-replay.js",
    "test:rotation": "node test/test-shadow-rotation.js",
    "postinstall": "node scripts/patch-anchor.js"
  },
  "knip": {
    "ignore": [
      "discord-listener/**"
    ]
  },
  "dependencies": {
    "@meteora-ag/dlmm": "1.9.4",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "dotenv": "^17.3.1",
    "jsonrepair": "^3.13.3",
    "node-cron": "^3.0.3",
    "openai": "^4.73.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
